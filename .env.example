# Variables de entorno requeridas (solo nombres, SIN valores reales)
# Copia este archivo a src/.env.local para desarrollo local
# y configura estas mismas variables en Vercel (Project Settings -> Environment Variables).

# URL del proyecto en Supabase (Project Settings -> API -> Project URL)
SUPABASE_URL=

# Clave de servidor de Supabase (Project Settings -> API -> service_role)
# Se usa exclusivamente en el backend (Next.js Route Handlers), nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
